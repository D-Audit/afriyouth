  const channels = [
    {
      icon: Mail,
      label: contactDetails.email.label,
      value: contactDetails.email.display,
      href: contactDetails.email.href,
    },
    {
      icon: Phone,
      label: contactDetails.phone.label,
      value: contactDetails.phone.display,
      href: contactDetails.phone.href,
