<file path="src/components/ui/StackedCards.tsx">
"use client";

import * as m from "motion/react-m";
import { useReducedMotion, useScroll, useTransform, type MotionValue } from "motion/react";
import { useRef, type CSSProperties, type ReactNode } from "react";

/** How much smaller each card further back in the pile ends up. */
const SHRINK = 0.035;

/**
 * A pile of cards. Each card sticks near the top of the screen while the next one slides
 * up over it, and the covered cards shrink slightly so their top edges stay visible as a
 * stack. The sticking is plain CSS (`position: sticky`); only the shrink is scripted, so
 * the section reads normally with JavaScript off or with reduced motion.
 */
export function StackedCards({ label, items }: { label: string; items: ReactNode[] }) {
  const ref = useRef<HTMLOListElement>(null);
  const { scrollYProgress } = useScroll({ target: ref, offset: ["start 0.12", "end end"] });

  return (
    <ol
      ref={ref}
      aria-label={label}
      className="[--stack-step:0.5rem] [--stack-top:5.25rem] sm:[--stack-step:0.875rem] sm:[--stack-top:6rem]"
    >
      {items.map((item, index) => (
        <StackedCard key={index} index={index} total={items.length} progress={scrollYProgress}>
          {item}
        </StackedCard>
      ))}
    </ol>
  );
}

function StackedCard({
  index,
  total,
  progress,
  children,
}: {
  index: number;
  total: number;
  progress: MotionValue<number>;
  children: ReactNode;
}) {
  const reduce = useReducedMotion();
  // A card starts shrinking when the next one begins to cover it and stops at the end.
  const scale = useTransform(progress, [index / total, 1], [1, 1 - (total - 1 - index) * SHRINK]);

  return (
    <li
      style={{ "--n": index } as CSSProperties}
      className="sticky top-[calc(var(--stack-top)+var(--n)*var(--stack-step))] pb-5 last:pb-0 sm:pb-6"
    >
      <m.div style={reduce ? undefined : { scale }} className="origin-top will-change-transform">
        {children}
      </m.div>
    </li>
  );
}
</file>

<file path="src/components/ui/StatCounter.tsx">
"use client";

import { animate, useInView, useReducedMotion } from "motion/react";
import { useEffect, useRef } from "react";
import type { Stat } from "@/content/impact";

/**
 * Shows a figure that counts up when scrolled into view.
 * While `value` is null (official figures pending) the placeholder text is shown instead.
 */
export function StatCounter({ stat, className }: { stat: Stat; className?: string }) {
  const numberRef = useRef<HTMLSpanElement>(null);
  const inView = useInView(numberRef, { once: true, margin: "0px 0px -10% 0px" });
  const reduceMotion = useReducedMotion();
  const target = stat.value;

  useEffect(() => {
    const node = numberRef.current;
    if (!node || target === null || !inView) return;
    if (reduceMotion) {
      node.textContent = target.toLocaleString("en");
      return;
    }
    const controls = animate(0, target, {
      duration: 1.6,
      ease: [0.22, 1, 0.36, 1],
      onUpdate: (latest) => {
        node.textContent = Math.round(latest).toLocaleString("en");
      },
    });
    return () => controls.stop();
  }, [inView, target, reduceMotion]);

  return (
    <div className={className}>
      <p className="font-display text-h1 tabular-nums">
        <span ref={numberRef}>{target === null ? stat.placeholder : (0).toLocaleString("en")}</span>
        {stat.suffix && <span className="text-accent-soft">{stat.suffix}</span>}
      </p>
      <p className="mt-2 text-on-night-muted">{stat.label}</p>
    </div>
  );
}
</file>

<file path="src/components/ui/Tabs.tsx">
"use client";

import { useId, useRef, useState, type KeyboardEvent, type ReactNode } from "react";
import { cn } from "@/lib/cn";

type TabsProps = {
  label: string;
  tabs: { id: string; label: string; panel: ReactNode }[];
  className?: string;
};

/** WAI-ARIA tabs: arrow keys move between tabs, Home/End jump to first/last. */
export function Tabs({ label, tabs, className }: TabsProps) {
  const baseId = useId();
  const [active, setActive] = useState(0);
  const tabRefs = useRef<(HTMLButtonElement | null)[]>([]);

  function focusTab(index: number) {
    const next = (index + tabs.length) % tabs.length;
    setActive(next);
    tabRefs.current[next]?.focus();
  }

  function onKeyDown(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    const keys: Record<string, () => void> = {
      ArrowRight: () => focusTab(index + 1),
      ArrowLeft: () => focusTab(index - 1),
      Home: () => focusTab(0),
      End: () => focusTab(tabs.length - 1),
    };
    const action = keys[event.key];
    if (action) {
      event.preventDefault();
      action();
    }
  }

  return (
    <div className={className}>
      <div
        role="tablist"
        aria-label={label}
        className="scrollbar-none -mx-1 flex gap-2 overflow-x-auto px-1 py-1"
      >
        {tabs.map((tab, index) => {
          const selected = index === active;
          return (
            <button
              key={tab.id}
              ref={(node) => {
                tabRefs.current[index] = node;
              }}
              id={`${baseId}-tab-${tab.id}`}
              type="button"
              role="tab"
              aria-selected={selected}
              aria-controls={`${baseId}-panel-${tab.id}`}
              tabIndex={selected ? 0 : -1}
              onClick={() => setActive(index)}
              onKeyDown={(event) => onKeyDown(event, index)}
              className={cn(
                "min-h-11 shrink-0 rounded-full border px-4 text-[0.9375rem] font-medium transition-colors duration-200 sm:px-5",
                selected
                  ? "border-ink bg-ink text-canvas"
                  : "border-ink/15 text-ink hover:bg-white",
              )}
            >
              {tab.label}
            </button>
          );
        })}
      </div>
      {tabs.map((tab, index) => (
        <div
          key={tab.id}
          id={`${baseId}-panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`${baseId}-tab-${tab.id}`}
          hidden={index !== active}
          tabIndex={0}
          className="mt-8 rounded-card-lg"
        >
          {tab.panel}
        </div>
      ))}
    </div>
  );
}
</file>

<file path="src/components/ui/TextReveal.tsx">
"use client";

import * as m from "motion/react-m";
import type { Variants } from "motion/react";

const container: Variants = {
  hidden: {},
  shown: { transition: { staggerChildren: 0.045 } },
};

const word: Variants = {
  hidden: { y: "110%" },
  shown: { y: "0%", transition: { duration: 0.8, ease: [0.22, 1, 0.36, 1] } },
};

function Words({ text, className }: { text: string; className?: string }) {
  return text.split(" ").map((part, index) => (
    <span key={index}>
      {index > 0 && " "}
      <span className="-mb-[0.14em] inline-block overflow-hidden pb-[0.14em] align-top">
        <m.span variants={word} className={`inline-block will-change-transform ${className ?? ""}`}>
          {part}
        </m.span>
      </span>
    </span>
  ));
}

/**
 * Headline whose words slide up from behind a mask, one after another, the first time
 * it scrolls into view. The text stays in the DOM in reading order for screen readers.
 */
export function TextReveal({
  title,
  emphasis,
  emphasisClassName,
}: {
  title: string;
  emphasis?: string;
  emphasisClassName?: string;
}) {
  return (
    <m.span
      variants={container}
      initial="hidden"
      whileInView="shown"
      viewport={{ once: true, margin: "0px 0px -10% 0px" }}
    >
      <Words text={title} />
      {emphasis && (
        <>
          {" "}
          <Words text={emphasis} className={emphasisClassName} />
        </>
      )}
    </m.span>
  );
}
</file>

<file path="src/components/ui/VelocityMarquee.tsx">
"use client";

import * as m from "motion/react-m";
import {
  useAnimationFrame,
  useMotionValue,
  useReducedMotion,
  useScroll,
  useSpring,
  useTransform,
  useVelocity,
} from "motion/react";
import { Fragment, useRef } from "react";

const wrap = (min: number, max: number, value: number) =>
  ((((value - min) % (max - min)) + (max - min)) % (max - min)) + min;

/**
 * Oversized band of words that drifts on its own and reacts to scrolling: scroll faster
 * and it speeds up and leans; scroll up and it reverses. Purely decorative.
 */
export function VelocityMarquee({
  words,
  baseSpeed = 2.2,
}: {
  words: string[];
  baseSpeed?: number;
}) {
  const reduce = useReducedMotion();
  const baseX = useMotionValue(0);
  const { scrollY } = useScroll();
  const velocity = useSpring(useVelocity(scrollY), { damping: 50, stiffness: 300 });
  const boost = useTransform(velocity, [-2000, 0, 2000], [-4, 0, 4], { clamp: false });
  const skewX = useTransform(velocity, [-2500, 0, 2500], [7, 0, -7]);
  const x = useTransform(baseX, (v) => `${wrap(-50, 0, v)}%`);
  const direction = useRef(1);

  useAnimationFrame((_, delta) => {
    if (reduce) return;
    const b = boost.get();
    if (b < -0.05) direction.current = -1;
    else if (b > 0.05) direction.current = 1;
    const move = direction.current * baseSpeed * (delta / 1000) * (1 + Math.abs(b));
    baseX.set(baseX.get() - move);
  });

  const row = (
    <div className="flex shrink-0 items-center">
      {words.map((word, index) => (
        <Fragment key={index}>
          <span className={index % 2 === 0 ? "text-ink" : "text-outline"}>{word}</span>
          <svg viewBox="0 0 24 24" className="mx-[0.35em] size-[0.42em] shrink-0 text-accent">
            <path
              fill="currentColor"
              d="M12 0c.6 6.4 5 11 12 12-7 1-11.4 5.6-12 12-.6-6.4-5-11-12-12C7 11 11.4 6.4 12 0Z"
            />
          </svg>
        </Fragment>
      ))}
    </div>
  );

  return (
    <div aria-hidden="true" className="overflow-hidden border-y border-line py-3.5 sm:py-4">
      <m.div
        style={reduce ? undefined : { x, skewX }}
        className="flex w-max whitespace-nowrap font-display text-[clamp(1.25rem,1rem+0.9vw,1.875rem)] font-medium leading-none tracking-[-0.025em]"
      >
        {row}
        {row}
      </m.div>
    </div>
  );
}
</file>

