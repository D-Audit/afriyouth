<file path="src/components/sections/ProgramExplorer.tsx">
"use client";

import { useMemo, useState } from "react";
import { FilterChips } from "@/components/ui/FilterChips";
import type { Program } from "@/content/programs";
import type { ServiceSlug } from "@/content/services";
import { ui } from "@/content/site";
import type { Status } from "@/content/types";
import { ProgramCard } from "./ProgramCard";

type Option<T extends string> = { value: T; label: string };

type ProgramExplorerProps = {
  programs: Program[];
  labels: { legend: string; topic: string; status: string };

  topicOptions: Option<ServiceSlug>[];
  statusOptions: Option<Status>[];
};

/** Filterable program grid (audience × topic × status). Results update live and are announced. */
export function ProgramExplorer({
  programs,
  labels,

  topicOptions,
  statusOptions,
}: ProgramExplorerProps) {
  const [topic, setTopic] = useState<ServiceSlug | null>(null);
  const [status, setStatus] = useState<Status | null>(null);

  const results = useMemo(
    () =>
      programs.filter(
        (program) => (!topic || program.topic === topic) && (!status || program.status === status),
      ),
    [programs, topic, status],
  );

  const filtered = topic || status;

  function clear() {
    setTopic(null);
    setStatus(null);
  }

  return (
    <div>
      <section
        aria-label={labels.legend}
        className="divide-y divide-line rounded-card-lg border border-line bg-white px-5 shadow-soft sm:px-7 [&>*]:py-5"
      >
        <FilterChips
          label={labels.topic}
          options={topicOptions}
          value={topic}
          onChange={setTopic}
        />
        {statusOptions.length > 0 && (
          <FilterChips
            label={labels.status}
            options={statusOptions}
            value={status}
            onChange={setStatus}
          />
        )}
      </section>

      <div className="mb-6 mt-10 flex min-h-11 items-center justify-between gap-4">
        <p role="status" className="label-caps text-muted">
          {ui.filterResultsLabel(results.length)}
        </p>
        {filtered && (
          <button
            type="button"
            onClick={clear}
            className="min-h-11 px-1 font-medium text-accent-ink underline-offset-4 hover:underline"
          >
            {ui.filterClear}
          </button>
        )}
      </div>

      {results.length > 0 ? (
        <ul className="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {results.map((program) => (
            <li key={program.slug} className="flex">
              <ProgramCard program={program} linkLabel={ui.viewDetails} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p className="rounded-card-lg border border-dashed border-sand-deep p-10 text-center text-muted">
          {ui.filterEmpty}
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/components/sections/ResourceExplorer.tsx">
"use client";

import Link from "next/link";
import { ArrowRight, FileText } from "lucide-react";
import { useState } from "react";
import { FilterChips } from "@/components/ui/FilterChips";
import type { Resource, ResourceType } from "@/content/impact";
import { ui } from "@/content/site";

type ResourceExplorerProps = {
  resources: Resource[];
  types: { value: ResourceType; label: string }[];
  filterLabel: string;
};

/** Resource list with a single "type" filter. */
export function ResourceExplorer({ resources, types, filterLabel }: ResourceExplorerProps) {
  const [type, setType] = useState<ResourceType | null>(null);
  const results = type ? resources.filter((resource) => resource.type === type) : resources;
  const typeLabel = (value: ResourceType) =>
    types.find((option) => option.value === value)?.label ?? value;

  return (
    <div>
      <FilterChips label={filterLabel} options={types} value={type} onChange={setType} />
      <p role="status" className="label-caps mb-4 mt-8 text-muted">
        {ui.filterResultsLabel(results.length)}
      </p>
      <ul className="divide-y divide-line border-y border-line">
        {results.map((resource) => (
          <li
            key={resource.id}
            className="group relative grid gap-3 py-6 sm:grid-cols-12 sm:items-center sm:gap-6"
          >
            <div className="flex items-center gap-3 sm:col-span-3">
              <FileText aria-hidden="true" strokeWidth={1.5} className="size-5 text-accent-ink" />
              <span className="label-caps text-muted">
                {typeLabel(resource.type)} · {resource.year}
              </span>
            </div>
            <div className="sm:col-span-6">
              <h3 className="text-lg font-medium">{resource.title}</h3>
              <p className="text-muted">{resource.summary}</p>
            </div>
            <Link
              href={resource.href}
              className="inline-flex min-h-11 items-center gap-2 font-medium text-accent-ink after:absolute after:inset-0 sm:col-span-3 sm:justify-end"
            >
              {resource.linkLabel}
              <span className="sr-only">: {resource.title}</span>
              <ArrowRight
                aria-hidden="true"
                strokeWidth={1.5}
                className="size-4 transition-transform group-hover:translate-x-0.5"
              />
            </Link>
          </li>
        ))}
      </ul>
    </div>
  );
}
