            >
              <div className="relative grid gap-12 lg:grid-cols-12 lg:gap-14">
                <div className="lg:col-span-7">
                  <SectionHeading
                    id="why-heading"
                    tone="accent"
                    size="h1"
                    label={why.label}
                    heading={why.heading}
                    intro={why.intro}
