  intro?: string;
  primary: LinkItem;
  secondary?: LinkItem;
  id?: string;
};

/** Closing call to action: a large centred statement on a dark panel with a rising accent glow. */
export function CtaBand({
  label,
  heading,
  intro,
  primary,
  secondary,
  id = "cta-heading",
}: CtaBandProps) {
  return (
    <section aria-labelledby={id} className="py-16 sm:py-24">
      <Container>
        <ScrollScale>
          <div
            data-surface="dark"
