# Copy this file to .env.local and fill in the values you need.
# None of these are exposed to the browser except variables prefixed NEXT_PUBLIC_.

# Public URL of the deployed site (used for canonical URLs, sitemap and social cards).
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Contact form email delivery via Resend (https://resend.com). Optional.
# When both RESEND_API_KEY and CONTACT_TO_EMAIL are set, form submissions are emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
